# Ornek ortam degiskenleri. Bu dosyayi .env olarak kopyalayip kendi
# degerlerinizi girin. .env dosyasi git tarafindan takip edilmez.

# --- Veritabani ---
# Varsayilani vardir, degistirmek istemiyorsaniz bos birakabilirsiniz.
DB_URL=jdbc:mysql://localhost:3306/vms?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
# ZORUNLU - MySQL kullanicinizin parolasi
DB_PASSWORD=degistir_beni

# --- JWT ---
# ZORUNLU - HS256 icin en az 32 karakter olmali.
# Uretmek icin:  openssl rand -base64 48
JWT_SECRET=en_az_32_karakterlik_rastgele_bir_deger_girin
# Token gecerlilik suresi (milisaniye). Varsayilan: 86400000 (24 saat)
JWT_EXPIRATION=86400000
